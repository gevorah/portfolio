---
import { profile } from '@/data/profile';
---

<section
  class="screen hero"
  id="universe"
  aria-labelledby="hero-title"
  tabindex="-1"
>
  <div class="hero-copy">
    <p class="hero-identity">
      <strong>{profile.name}</strong>, {profile.title.toLowerCase()}
    </p>
    <h1 class="display" id="hero-title">
      <span>
        <span>Construyo</span> <span>sistemas.</span>
      </span>
      <span class="voice">
        <span>Imagino</span> <span>mundos.</span>
      </span>
    </h1>
    <p class="prose">{profile.summary}</p>
    <div class="hero-actions">
      <a class="button" href="#work">
        Explorar mi trabajo
      </a>
      <a class="link" href="#experience">
        Ver mi trayectoria
      </a>
    </div>
  </div>
  <div class="stage-slot" aria-hidden="true">
    <div data-frame="hero"></div>
  </div>
</section>
