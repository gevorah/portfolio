---
import { profile } from '@/data/profile';
---

<section
  class="screen hero"
  id="universe"
  aria-labelledby="hero-title"
  tabindex="-1"
>
  <div class="hero-copy">
    <h1 class="hero-title" id="hero-title">
      <span class="hero-greeting">
        {`Hi, I'm ${profile.name},`.split(' ').map((word, index) => (
          <>
            <span class="word" style={`--w:${index}`}>
              <span>{word}</span>
            </span>{' '}
          </>
        ))}
      </span>
      <span class="hero-role">
        <span class="ink">a {profile.title.toLowerCase()}.</span>
      </span>
    </h1>
    <p class="prose hero-summary">{profile.summary}</p>
    <div class="hero-actions">
      <a class="button" href="#work">
        Explore my work
      </a>
      <a class="link" href="#experience">
        My experience
      </a>
    </div>
  </div>
  <div class="stage-slot" aria-hidden="true">
    <div data-frame="hero"></div>
  </div>
</section>
