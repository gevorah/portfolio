---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

import highTide from '@/assets/umbral/high-tide.jpg';
import lowTide from '@/assets/umbral/low-tide.jpg';
import { worlds, type StudyImage } from '@/data/worlds';

const studyImages: Record<StudyImage, ImageMetadata> = {
  'high-tide': highTide,
  'low-tide': lowTide,
};
---

<section
  class="screen work"
  id="work"
  aria-labelledby="work-title"
  tabindex="-1"
>
  <div class="markers">
    {worlds.map((world) => (
      <button
        type="button"
        class="marker world-marker"
        aria-label={`Explore ${world.name}`}
        data-world-marker={world.id}
        data-stage={world.stage}
        data-offstage
      >
        <span class="marker-label" aria-hidden="true">
          {world.name}
        </span>
      </button>
    ))}
  </div>

  <div class="stage-slot" aria-hidden="true">
    <div data-frame="atlas"></div>
    <div data-frame="focus"></div>
  </div>

  <div class="work-content">
    <div class="work-prompt">
      <h2 class="section-title" id="work-title">
        Explore my work.
      </h2>
      <p class="section-lede">Select a world to learn more.</p>
      <ul class="world-index">
        {worlds.map((world) => (
          <li>
            <button type="button" data-world-select={world.id}>
              <span class="name">{world.name}</span>
              <span class="kind">{world.kind}</span>
            </button>
          </li>
        ))}
      </ul>
    </div>

    <p class="sr-only" role="status" data-world-status></p>

    <div class="work-detail">
      <div class="detail-controls">
        <button type="button" class="back-button" data-return>
          <svg
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M7 3 2 8l5 5M2 8h12"></path>
          </svg>
          Back to the system
        </button>
        <div class="steps">
          <button
            type="button"
            class="round-button"
            data-step="-1"
            aria-label="Previous world"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M10 3 5 8l5 5"></path>
            </svg>
          </button>
          <button
            type="button"
            class="round-button"
            data-step="1"
            aria-label="Next world"
          >
            <svg
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="m6 3 5 5-5 5"></path>
            </svg>
          </button>
        </div>
      </div>
      {worlds.map((world) => (
        <article
          class="world-detail"
          id={`world-${world.id}`}
          data-world-detail={world.id}
          aria-labelledby={`world-${world.id}-title`}
        >
          <p class="world-meta" style="--i:0">
            <span>
              {[world.kind, world.context].filter(Boolean).join(', ')}
            </span>
            {world.status && <span class="status">{world.status}</span>}
          </p>
          <h3
            class:list={['world-name', { 'is-long': world.name.length > 12 }]}
            id={`world-${world.id}-title`}
            data-world-heading
            tabindex="-1"
            style="--i:1"
          >
            {world.name}
          </h3>
          <p class="world-tagline" style="--i:2">
            {world.tagline}
          </p>
          <p class="prose" style="--i:3">
            {world.description}
          </p>
          {world.study && (
            <figure class="world-study" style="--i:4">
              <div class="frames">
                {world.study.frames.map((frame) => (
                  <div class="frame">
                    <Image
                      src={studyImages[frame.image]}
                      alt={frame.alt}
                      widths={[320, 480, 720]}
                      sizes="(min-width: 56.25rem) 15rem, 45vw"
                      loading="lazy"
                    />
                    <span>{frame.label}</span>
                  </div>
                ))}
              </div>
              <figcaption>{world.study.caption}</figcaption>
            </figure>
          )}
          {world.note && (
            <p class="world-note" style="--i:6">
              {world.note}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>
