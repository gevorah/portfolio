---
import { Image } from 'astro:assets';

import avatar from '@/assets/avatar.png';
import { profile } from '@/data/profile';
---

<header class="site-header">
  <a
    href="#universe"
    class="brand"
    aria-label={`${profile.handle}: volver al universo`}
  >
    <Image src={avatar} alt="" width={64} height={64} loading="eager" />
    {profile.handle}
  </a>
  <nav class="site-nav" aria-label="Secciones">
    <a href="#universe" data-nav="hero" class="nav-optional">
      Universo
    </a>
    <a href="#work" data-nav="work">
      Trabajo
    </a>
    <a href="#experience" data-nav="career">
      Trayectoria
    </a>
    <a href="#contact" data-nav="outro" class="nav-optional">
      Contacto
    </a>
  </nav>
</header>
