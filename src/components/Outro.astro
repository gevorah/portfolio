---
import { Image } from 'astro:assets';

import avatar from '@/assets/avatar.png';
import { profile } from '@/data/profile';
---

<div class="outro">
  <section class="about" id="about" aria-labelledby="about-title" tabindex="-1">
    <div>
      <p class="about-portrait">
        <Image
          src={avatar}
          alt="gevorah avatar: a reptile eye"
          width={144}
          height={144}
        />
        <span>
          {profile.name}
          <br />
          {profile.location}
        </span>
      </p>
      <h2 class="display" id="about-title">
        Engineering, with curiosity.
      </h2>
    </div>
    <div class="about-body prose">
      {profile.about.map((paragraph) => (
        <p>{paragraph}</p>
      ))}
      <p>{profile.education}.</p>
    </div>
  </section>

  <section
    class="contact"
    id="contact"
    aria-labelledby="contact-title"
    tabindex="-1"
  >
    <h2 class="display" id="contact-title">
      Let’s talk.
    </h2>
    <ul class="contact-list">
      {profile.contact.map((channel) => (
        <li>
          <a
            href={channel.href}
            {...(channel.href.startsWith('http')
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            <span class="channel">{channel.label}</span>
            <span class="address">{channel.value}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="site-footer">
      {profile.handle}, Small Worlds. Built with Astro and Three.js.
    </p>
  </section>
</div>
