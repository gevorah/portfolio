---
import { profile } from '@/data/profile';

const year = new Date().getFullYear();
const symbols: Record<(typeof profile.contact)[number]['label'], string> = {
  Email: 'M3.5 6h17v12h-17zM4 6.5l8 6.5 8-6.5',
  LinkedIn:
    'M4.5 9.5h3v9h-3zM6 4.5a1.6 1.6 0 1 1 0 3.2 1.6 1.6 0 0 1 0-3.2zM10 9.5h2.9v1.3c.5-.9 1.6-1.5 3-1.5 2.7 0 3.6 1.6 3.6 4.3v4.9h-3v-4.4c0-1.1-.2-2.2-1.6-2.2s-1.9 1-1.9 2.2v4.4h-3z',
  GitHub:
    'M12 3a9 9 0 0 0-2.8 17.5c.4.1.6-.2.6-.4v-1.6c-2.5.5-3-1.1-3-1.1-.4-1-1-1.3-1-1.3-.8-.6.1-.6.1-.6.9.1 1.4.9 1.4.9.8 1.4 2.1 1 2.6.8.1-.6.3-1 .6-1.2-2-.2-4.1-1-4.1-4.4 0-1 .3-1.8.9-2.4-.1-.2-.4-1.1.1-2.4 0 0 .8-.2 2.5.9a8.6 8.6 0 0 1 4.5 0c1.7-1.1 2.5-.9 2.5-.9.5 1.3.2 2.2.1 2.4.6.6.9 1.4.9 2.4 0 3.5-2.1 4.2-4.1 4.4.3.3.6.8.6 1.6v2.4c0 .2.2.5.6.4A9 9 0 0 0 12 3z',
};
---

<section
  class="screen about"
  id="about"
  aria-labelledby="about-title"
  tabindex="-1"
>
  <div class="about-copy">
    <h2 class="about-title" id="about-title">
      Beyond <span>the code.</span>
    </h2>
    <p class="about-text">
      {profile.about.lead} <strong>{profile.about.emphasis}</strong>
    </p>
    <dl class="about-details">
      <div>
        <dt>Education</dt>
        <dd>
          {profile.education.degree}
          <span>
            {profile.education.institution} · {profile.education.year}
          </span>
        </dd>
      </div>
      <div>
        <dt>Based in</dt>
        <dd>{profile.location}</dd>
      </div>
    </dl>
  </div>
  <div class="stage-slot comet" aria-hidden="true">
    <div data-frame="about"></div>
  </div>
</section>

<section
  class="screen contact"
  id="contact"
  aria-labelledby="contact-title"
  tabindex="-1"
>
  <div class="stage-slot nebula" aria-hidden="true">
    <div data-frame="contact"></div>
  </div>
  <div class="contact-body">
    <h2 class="contact-title" id="contact-title">
      Let's talk.
    </h2>
    <p class="contact-lede">
      Have a project, an idea, or something you'd like to discuss? I'd love to
      hear from you.
    </p>
    <ul class="contact-list">
      {profile.contact.map((channel) => (
        <li>
          <a
            class="contact-row"
            href={channel.href}
            {...(channel.href.startsWith('http')
              ? { target: '_blank', rel: 'noopener noreferrer' }
              : {})}
          >
            <span class="contact-channel">
              <svg
                viewBox="0 0 24 24"
                fill={channel.label === 'Email' ? 'none' : 'currentColor'}
                stroke={channel.label === 'Email' ? 'currentColor' : 'none'}
                stroke-width="1.4"
                aria-hidden="true"
              >
                <path d={symbols[channel.label]}></path>
              </svg>
              {channel.label}
            </span>
            <span class="contact-address">{channel.value}</span>
            <span class="contact-arrow" aria-hidden="true">
              ↗
            </span>
            {channel.href.startsWith('http') && (
              <span class="sr-only"> (opens in a new tab)</span>
            )}
          </a>
        </li>
      ))}
    </ul>
  </div>
  <footer class="site-footer">
    <span>
      © {year} {profile.credit}
    </span>
  </footer>
</section>
